            "DDL": "CREATE TABLE `product` (\n  `id` int(11) NOT NULL AUTO_INCREMENT,\n  `name` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci NOT NULL,\n  `category_id` int(11) NOT NULL,\n  `brand_id` int(11) DEFAULT NULL,\n  `price` decimal(10,2) NOT NULL,\n  `original_price` decimal(10,2) DEFAULT NULL,\n  `stock` int(11) NOT NULL,\n  `sales` int(11) DEFAULT '0',\n  `rating` decimal(3,2) DEFAULT '5.00',\n  `description` text CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci,\n  `specs` text CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci,\n  `image` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci DEFAULT NULL,\n  `images` text CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci,\n  `status` int(11) DEFAULT '1',\n  `created_at` datetime DEFAULT CURRENT_TIMESTAMP,\n  `updated_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n  `size` varchar(100) DEFAULT NULL COMMENT '产品尺寸，如120x60x80cm',\n  PRIMARY KEY (`id`) USING BTREE,\n  KEY `idx_category` (`category_id`) USING BTREE,\n  KEY `idx_brand` (`brand_id`) USING BTREE,\n  CONSTRAINT `product_ibfk_1` FOREIGN KEY (`category_id`) REFERENCES `category` (`id`),\n  CONSTRAINT `product_ibfk_2` FOREIGN KEY (`brand_id`) REFERENCES `brand` (`id`)\n) ENGINE=InnoDB AUTO_INCREMENT=57 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci ROW_FORMAT=DYNAMIC",
